# Copy this file to .env.local and fill in real values.
# Get these from your Supabase project: Settings -> API.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Base URL of this site. Used to build OAuth/email redirect links.
# Locally:
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# In production (Vercel env vars), set this to:
# NEXT_PUBLIC_SITE_URL=https://claude.cdlav.us

# Optional. Get one from console.anthropic.com -> API Keys.
# Powers the "Get AI feedback" button on practicums. Without this set,
# that button is hidden and the app works exactly as before — pass/fail
# grading never depends on this key.
ANTHROPIC_API_KEY=
